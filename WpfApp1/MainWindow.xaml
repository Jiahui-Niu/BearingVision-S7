<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:WpfApp1.UserControls"
        xmlns:vmctl="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release"
        Title="成品轴承外观机" WindowState="Maximized"
        Background="#1E5C1E" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部菜单 -->
        <Menu DockPanel.Dock="Top" Background="#2A7A2A" Foreground="White">
            <MenuItem Header="方案" Foreground="White">
                <MenuItem Header="选择方案文件" Click="MenuSelectSolution_Click"/>
                <MenuItem Header="加载方案" Click="MenuLoadSolution_Click"/>
            </MenuItem>
            <MenuItem Header="相机设置" Foreground="White" Click="MenuCameraSet_Click"/>
            <MenuItem Header="全局变量" Foreground="White" Click="MenuGlobalVar_Click"/>
            <MenuItem Header="光源通讯" Foreground="White" Click="MenuLightComm_Click"/>
            <MenuItem Header="登录" Foreground="White" HorizontalAlignment="Right" Click="MenuLogin_Click"/>
        </Menu>

        <!-- 导航标签 -->
        <TabControl x:Name="mainTab" DockPanel.Dock="Top" Background="#1E5C1E"
                    BorderThickness="0" Padding="0" Height="Auto">
            <!-- 主页面 -->
            <TabItem Header="主页面">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：6相机图像 -->
                    <uc:MainImageShowUserControl Grid.Column="0" DataContext="{Binding}"/>

                    <!-- 右侧：控制面板（生产数据/操作控制等，与"方案配置"页共用同一控件） -->
                    <uc:ProductionSidebarUserControl Grid.Column="1" DataContext="{Binding}"/>
                </Grid>
            </TabItem>

            <!-- 方案配置：内嵌VisionMaster原生工作台(VmFrontendControl)，
                 加载方案后由VM自身渲染流程编辑区/工具箱/图像与模块结果/历史结果；
                 右侧生产数据面板与"主页面"共用同一控件，方便配置方案时同步查看/操作生产 -->
            <TabItem Header="方案配置">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- 顶部工具栏：方案路径/方案选择/进度/保存方案/新型号 -->
                    <WrapPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                        <TextBlock Text="方案路径：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Width="320" Text="{Binding SolutionPath}" Margin="0,0,4,0"/>
                        <Button Content="浏览" Width="60" Style="{StaticResource GreenButton}"
                                Click="BtnBrowseSolution_Click" Margin="0,0,16,0"/>

                        <TextBlock Text="方案选择：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="140" ItemsSource="{Binding SolutionFileList}"
                                  SelectedItem="{Binding SelectedSolutionFile}" Margin="0,0,16,0"/>

                        <TextBlock Text="进度：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ProgressBar Width="120" Height="18" Minimum="0" Maximum="100"
                                     Value="{Binding LoadProgress}" IsIndeterminate="{Binding IsLoadingSolution}"
                                     Margin="0,0,16,0"/>

                        <Button Content="保存方案" Width="80" Style="{StaticResource GreenButton}"
                                Command="{Binding SaveSolutionCommand}" Margin="0,0,24,0"/>

                        <TextBlock Text="新型号：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Width="120" Text="{Binding NewModelNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                        <Button Content="新增" Width="60" Style="{StaticResource GreenButton}"
                                Command="{Binding AddNewModelCommand}"/>
                    </WrapPanel>

                    <!-- VM操作台 + 图像显示：VisionMaster原生工作台，方案加载后自动呈现完整编辑环境。
                         未设置方案路径时，下方占位说明会显示；VmFrontendControl一旦渲染出真实内容会盖住占位说明 -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#3A8A3A" BorderThickness="1">
                        <Grid>
                            <StackPanel Visibility="{Binding ShowSolutionPlaceholder, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="VM 方案工作台" FontSize="20" FontWeight="Bold"
                                           Foreground="#88DD88" HorizontalAlignment="Center"/>
                                <TextBlock Text="这里将显示 VisionMaster 原生编辑界面：左侧流程图编辑区与工具箱、右侧图像与模块结果、下方历史结果，均由 VM 自身渲染。"
                                           Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="请先在上方“方案路径”选择或浏览一个 .sol 方案文件，导入后此处会自动加载显示。"
                                           Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <vmctl:VmFrontendControl x:Name="VmFrontend"/>
                        </Grid>
                    </Border>

                    <!-- 右侧：控制面板（与"主页面"共用同一控件） -->
                    <uc:ProductionSidebarUserControl Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                      Margin="6,0,0,0" DataContext="{Binding}"/>
                </Grid>
            </TabItem>

            <!-- 检测配置 -->
            <TabItem Header="检测配置">
                <uc:CheckSetUserControl DataContext="{Binding CheckSetVM}"/>
            </TabItem>

            <!-- 设置：非VM原生的运行时/硬件相关配置（原方案配置页内容迁移至此） -->
            <TabItem Header="设置">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <Button Content="保存" Style="{StaticResource GreenButton}" Width="80"
                                HorizontalAlignment="Left" Margin="0,4"
                                Command="{Binding SaveConfigCommand}"/>

                        <GroupBox Header="方案参数" Margin="0,4">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="物料有没围：" VerticalAlignment="Center" FontSize="10"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding HasEnclosure}" VerticalAlignment="Center"/>
                            </Grid>
                        </GroupBox>

                        <!-- 通行模式 -->
                        <GroupBox Header="通行模式" Margin="0,4">
                            <UniformGrid Columns="3" Rows="2">
                                <CheckBox Content="相机1" IsChecked="{Binding Config.CameraEnable[0]}" Margin="8,4"/>
                                <CheckBox Content="相机2" IsChecked="{Binding Config.CameraEnable[1]}" Margin="8,4"/>
                                <CheckBox Content="相机3" IsChecked="{Binding Config.CameraEnable[2]}" Margin="8,4"/>
                                <CheckBox Content="相机4" IsChecked="{Binding Config.CameraEnable[3]}" Margin="8,4"/>
                                <CheckBox Content="相机5" IsChecked="{Binding Config.CameraEnable[4]}" Margin="8,4"/>
                                <CheckBox Content="相机6" IsChecked="{Binding Config.CameraEnable[5]}" Margin="8,4"/>
                            </UniformGrid>
                        </GroupBox>

                        <!-- 调试触发 -->
                        <GroupBox Header="调试触发" Margin="0,4">
                            <UniformGrid Columns="3" Rows="2">
                                <Button Content="相机1触发" Style="{StaticResource TriggerButton}" Margin="4"
                                        Command="{Binding ManualTriggerCommand}" CommandParameter="0"/>
                                <Button Content="相机2触发" Style="{StaticResource TriggerButton}" Margin="4"
                                        Command="{Binding ManualTriggerCommand}" CommandParameter="1"/>
                                <Button Content="相机3触发" Style="{StaticResource TriggerButton}" Margin="4"
                                        Command="{Binding ManualTriggerCommand}" CommandParameter="2"/>
                                <Button Content="相机4触发" Style="{StaticResource TriggerButton}" Margin="4"
                                        Command="{Binding ManualTriggerCommand}" CommandParameter="3"/>
                                <Button Content="相机5触发" Style="{StaticResource TriggerButton}" Margin="4"
                                        Command="{Binding ManualTriggerCommand}" CommandParameter="4"/>
                                <Button Content="相机6触发" Style="{StaticResource TriggerButton}" Margin="4"
                                        Command="{Binding ManualTriggerCommand}" CommandParameter="5"/>
                            </UniformGrid>
                        </GroupBox>

                        <uc:BrightnessUserControl DataContext="{Binding BrightnessVM}" Margin="0,4"/>
                        <uc:TCPClientUserControl DataContext="{Binding TCPClientVM}" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 实时图像 -->
            <TabItem Header="实时图像">
                <uc:MainImageShowUserControl DataContext="{Binding}"/>
            </TabItem>

            <!-- 显示数据 -->
            <TabItem Header="显示数据">
                <uc:DataSelectUserControl DataContext="{Binding}"/>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="#155015" Foreground="White">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="PLC: "/>
                    <Run Text="{Binding IsConnected, Converter={StaticResource BoolToVis}}" Foreground="#00FF00"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentUserName}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 填充区域 -->
        <Grid/>
    </DockPanel>
</Window>
